# Database
DATABASE_URL=postgresql://postgres:root@localhost:5432/job_board

# Authentication
SECRET_KEY=replace-with-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Groq LLM settings
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL_THINKING=llama-3.3-70b-versatile
GROQ_MODEL_MEDIUM=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# Embeddings / Vector store
HF_TOKEN=replace-with-your-huggingface-token-if-required
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DB_PATH=./chroma_db
